# ─── Banco de dados (Neon PostgreSQL) ───────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# ─── Autenticação ────────────────────────────────────────────────────────────
# Chave aleatória longa usada para assinar sessões JWT
NEON_AUTH_COOKIE_SECRET=gere-com-openssl-rand-base64-32
AUTH_SECRET=gere-com-openssl-rand-base64-32

# ─── Stitch with Google (Design System) ──────────────────────────────────────
# Chave de API do Stitch with Google para integração de design
# NUNCA commite o valor real — mantenha apenas no .env.local ou variáveis Vercel
STITCH_GOOGLE_API_KEY=

# ─── Ambiente ────────────────────────────────────────────────────────────────
NODE_ENV=development
