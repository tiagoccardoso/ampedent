# Neon Postgres — copie de: https://console.neon.tech → Connection string
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Segredo para assinar tokens JWT. Gere com: openssl rand -hex 32
JWT_SECRET=troque_por_um_segredo_de_pelo_menos_32_caracteres

# URL pública do site (usada por Next.js)
NEXT_PUBLIC_APP_URL=http://localhost:3000
